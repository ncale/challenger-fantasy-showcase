  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/"
  },
  "vars": {
    "POSTHOG_KEY": "phc_kU1Tev2pUMNSdLmmfnAWc5owil6pdxjW7SAdYsZLXiQ",
    "POSTHOG_HOST": "https://ph.challengerfantasy.com"
  },
  "routes": [
    {
      "pattern": "challengerfantasy.com",
      "custom_domain": true
    }
  ]
}
