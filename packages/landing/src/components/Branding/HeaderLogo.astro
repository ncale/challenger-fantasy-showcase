---
import { cn } from "~/lib/utils";

export interface Props {
  withLink?: boolean;
  column?: boolean;
  size?: "sm" | "full";
  /** Optional extra class name */
  class?: string;
}

const { withLink = false, column = false, size = "full", class: extra = "" } = Astro.props as Props;

const headerLogoClass = cn("flex-shrink-0 flex items-center relative", column && "flex-col", extra);

const imgClass = cn("h-8 invert dark:invert-0", size === "sm" && "h-5");
const titleClass = cn(
  "text-xl ml-2 font-bold text-foreground uppercase select-none",
  size === "sm" && "text-lg",
);
---

{
  withLink ? (
    <a href="/" class={headerLogoClass}>
      <img
        src="/wreath-logo-2-w.svg"
        alt="Challenger Fantasy Logo"
        class={imgClass}
      />
      <div>
        <h1 class={titleClass}>Challenger</h1>
      </div>
    </a>
  ) : (
    <div class={headerLogoClass}>
      <img
        src="/wreath-with-text-w-2.svg"
        alt="Challenger Fantasy Logo"
        class={imgClass}
      />
      {/* <h1 class={titleClass}>Challenger</h1> */}
    </div>
  )
}
