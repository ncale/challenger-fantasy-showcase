---
import { LINKS } from "@challenger-fantasy/core";
import { XIcon } from "@lucide/astro";
import HeaderLogo from "./Branding/HeaderLogo.astro";
---

<header
	class="fixed top-0 left-0 right-0 h-header-height z-30 bg-background/80 backdrop-blur-md border-b border-border/60"
>
	<div
		class="h-full grid grid-cols-3 items-center px-5 max-w-7xl mx-auto lg:px-8"
	>
		<!-- Left: Logo -->
		<a href="/" class="flex items-center gap-3 text-foreground no-underline">
			<HeaderLogo />
		</a>

		<!-- Center: Desktop nav (visible on lg+) -->
		<nav class="hidden lg:flex items-stretch justify-center h-full">
			<a
				href="/about"
				class="w-24 flex items-center justify-center text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
				>About</a
			>
			<a
				href="/support"
				class="w-24 flex items-center justify-center text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
				>Support</a
			>
		</nav>

		<!-- Right: Desktop actions (visible on lg+) -->
		<div class="hidden lg:flex items-center justify-end gap-3">
			<a
				href={LINKS.IOS_STORE_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-block hover:opacity-80 transition-opacity"
			>
				<img
					src="/Download_on_App_Store/White_lockup/SVG/Download_on_the_App_Store_Badge_US-UK_RGB_wht_092917.svg"
					alt="Download on the App Store"
					class="h-10"
				/>
			</a>
		</div>

		<!-- Mobile hamburger (hidden on lg+) -->
		<button
			class="relative flex flex-col gap-1 bg-transparent border-none cursor-pointer p-2 lg:hidden col-span-2 justify-self-end"
			id="hamburger"
			aria-label="Toggle menu"
			aria-controls="overlay-menu"
			aria-expanded="false"
			type="button"
		>
			<span
				class="hamburger-line w-6 h-0.5 bg-foreground transition-all duration-150"
			></span>
			<span
				class="hamburger-line w-6 h-0.5 bg-foreground transition-all duration-150"
			></span>
			<span
				class="hamburger-line w-6 h-0.5 bg-foreground transition-all duration-150"
			></span>
		</button>
	</div>
</header>

<!-- Full screen overlay menu (mobile/tablet only) -->
<div
	id="overlay-menu"
	class="fixed inset-0 bg-background flex flex-col transition-all duration-200 z-[100] opacity-0 invisible lg:hidden"
	role="dialog"
	aria-modal="true"
>
	<!-- Header with close button -->
	<div class="flex items-center justify-between p-4 border-b border-border">
		<a href="/" class="flex items-center gap-3 text-foreground no-underline">
			<HeaderLogo />
		</a>

		<button
			class="p-2 hover:bg-accent rounded-lg transition-colors"
			id="close-menu"
			aria-label="Close menu"
			type="button"
		>
			<XIcon />
		</button>
	</div>

	<!-- Overlay content -->
	<div class="flex-1 flex flex-col items-center justify-start px-6 pt-16 pb-12">
		<nav class="flex flex-col gap-8 text-center mb-12">
			<a
				href="/"
				class="text-4xl font-semibold text-foreground hover:text-primary transition-colors"
				>Home</a
			>
			<a
				href="/about"
				class="text-4xl font-semibold text-foreground hover:text-primary transition-colors"
				>About</a
			>
			<a
				href="/support"
				class="text-4xl font-semibold text-foreground hover:text-primary transition-colors"
				>Support</a
			>
		</nav>

		<div class="flex flex-col items-center gap-4 w-full max-w-sm">
			<a
				href={LINKS.IOS_STORE_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-block hover:opacity-80 transition-opacity"
			>
				<img
					src="/Download_on_App_Store/White_lockup/SVG/Download_on_the_App_Store_Badge_US-UK_RGB_wht_092917.svg"
					alt="Download on the App Store"
					class="h-14"
				/>
			</a>
		</div>
	</div>
</div>

<script>
	// Mobile-only menu toggling
	const hamburger = document.getElementById("hamburger");
	const overlayMenu = document.getElementById("overlay-menu");
	const closeMenu = document.getElementById("close-menu");

	function openMenu() {
		overlayMenu?.classList.remove("opacity-0", "invisible");
		overlayMenu?.classList.add("opacity-100", "visible");
		hamburger?.classList.add("open");
		hamburger?.setAttribute("aria-expanded", "true");
		document.body.style.overflow = "hidden";
	}

	function closeMenuFunc() {
		overlayMenu?.classList.remove("opacity-100", "visible");
		overlayMenu?.classList.add("opacity-0", "invisible");
		hamburger?.classList.remove("open");
		hamburger?.setAttribute("aria-expanded", "false");
		document.body.style.overflow = "";
	}

	hamburger?.addEventListener("click", () => {
		const isOpen = overlayMenu?.classList.contains("opacity-100");
		isOpen ? closeMenuFunc() : openMenu();
	});

	closeMenu?.addEventListener("click", closeMenuFunc);

	// Close when tapping any overlay nav link
	overlayMenu?.querySelectorAll("nav a")?.forEach((a) => {
		a.addEventListener("click", closeMenuFunc);
	});
</script>

<style>
	/* Hamburger animation lines */
	#hamburger .hamburger-line {
		transform-origin: 3px 3px;
	}
	#hamburger.open .hamburger-line:nth-child(1) {
		transform: rotate(45deg) translate(3px, 3px);
	}
	#hamburger.open .hamburger-line:nth-child(2) {
		opacity: 0;
	}
	#hamburger.open .hamburger-line:nth-child(3) {
		transform: rotate(-45deg) translate(4px, -4px);
	}
</style>
