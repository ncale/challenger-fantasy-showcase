---
interface Props {
  name?: string | null;
  role?: string | null;
}

const { name, role } = Astro.props;
---

{(name || role) && (
  <div class="mt-14 pt-8 border-t border-border flex items-center gap-4">
    <div class="w-10 h-10 rounded-full bg-primary/15 text-primary flex items-center justify-center text-sm font-bold shrink-0">
      {name?.charAt(0) ?? "—"}
    </div>
    <div>
      {name && <p class="text-sm font-semibold text-foreground">{name}</p>}
      {role && <p class="text-xs text-muted-foreground">{role}</p>}
    </div>
  </div>
)}
