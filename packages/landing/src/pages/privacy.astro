---
import { getEntry, render } from "astro:content";

const entry = await getEntry("pages", "privacy");
const { Content } = entry ? await render(entry) : { Content: null };
const title = entry?.data.title ?? "Privacy Policy";
const lastUpdated = entry?.data.updatedDate
  ? entry.data.updatedDate.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <title>{title} — Challenger Fantasy</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
        font-size: 15px;
        line-height: 1.75;
        color: #d1d5db;
        background: #0f0f0f;
        padding: 96px 24px 128px;
      }

      .doc {
        max-width: 680px;
        margin: 0 auto;
      }

      h1 {
        font-size: 22px;
        font-weight: 600;
        color: #f9fafb;
        margin-bottom: 32px;
      }
      h2 {
        font-size: 15px;
        font-weight: 600;
        color: #f9fafb;
        margin-top: 36px;
        margin-bottom: 10px;
      }
      h3 {
        font-size: 14px;
        font-weight: 600;
        color: #e5e7eb;
        margin-top: 24px;
        margin-bottom: 8px;
      }
      p {
        margin-bottom: 14px;
      }
      ul,
      ol {
        padding-left: 20px;
        margin-bottom: 14px;
      }
      li {
        margin-bottom: 4px;
      }
      a {
        color: #60a5fa;
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      strong {
        color: #e5e7eb;
        font-weight: 600;
      }
      hr {
        border: none;
        border-top: 1px solid #1f2937;
        margin: 32px 0;
      }

      .meta { font-size: 12px; color: #6b7280; margin-bottom: 40px; }

      @media (max-width: 480px) {
        body {
          padding: 72px 20px 96px;
        }
      }
    </style>
  </head>
  <body>
    <div class="doc">
      <h1>{title}</h1>
      {lastUpdated && <p class="meta">Last updated: {lastUpdated}</p>}
      {Content ? <Content /> : <p>Privacy Policy coming soon.</p>}
    </div>
  </body>
</html>
