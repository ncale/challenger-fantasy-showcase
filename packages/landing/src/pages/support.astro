---
import { getCollection, getEntry } from "astro:content";
import DefaultLayout from "~/layouts/DefaultLayout.astro";
import "~/styles/global.css";

const support = await getEntry("pages", "support");
const faqs = (await getCollection("faqs")).sort((a, b) => a.data.sort - b.data.sort);

// Group FAQs by category, preserving insertion order
const faqsByCategory = faqs.reduce<Record<string, typeof faqs>>((acc, faq) => {
  if (!acc[faq.data.category]) acc[faq.data.category] = [];
  acc[faq.data.category]?.push(faq);
  return acc;
}, {});

const contactHeading = support?.data.contactTitle ?? "Still need help?";
const contactBody =
  support?.data.contactContent ?? "Reach out and we'll get back to you as soon as we can.";
const contactEmail = "support@challengerfantasy.com";
---

<DefaultLayout>
  <main class="flex-1 pt-header-height">
    <div class="max-w-2xl mx-auto px-6 sm:px-8 py-16 sm:py-24">

      <!-- Header -->
      <div class="mb-12">
        <p class="text-xs font-semibold tracking-widest uppercase text-primary mb-4">
          Support
        </p>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-tight">
          {support?.data.title ?? "We're here to help"}
        </h1>
      </div>

      <!-- FAQ -->
      {
        Object.keys(faqsByCategory).length > 0 ? (
          <div class="mb-16 space-y-10">
            {Object.entries(faqsByCategory).map(([category, items]) => (
              <div>
                <h2 class="text-xs font-semibold tracking-widest uppercase text-primary mb-4">
                  {category}
                </h2>
                <div class="divide-y divide-border border-t border-border">
                  {items.map((faq) => (
                    <details class="group">
                      <summary class="flex items-center justify-between gap-6 py-5 cursor-pointer list-none text-foreground font-medium text-base leading-snug min-h-[2.5rem]">
                        <span>{faq.data.question}</span>
                        <span
                          class="shrink-0 text-xl text-muted-foreground transition-transform duration-200 group-open:rotate-45"
                          aria-hidden="true"
                        >
                          +
                        </span>
                      </summary>
                      <p class="pb-5 text-sm text-muted-foreground leading-relaxed">
                        {faq.data.answer}
                      </p>
                    </details>
                  ))}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="mb-16 text-muted-foreground text-sm">No FAQs yet. Check back soon.</p>
        )
      }

      <!-- Contact -->
      <div class="pt-8 border-t border-border">
        <p class="text-xs font-semibold tracking-widest uppercase text-primary mb-4">
          Contact
        </p>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-3">
          {contactHeading}
        </h2>
        <p class="text-base text-muted-foreground leading-relaxed mb-6">
          {contactBody}
        </p>
        <a
          href={`mailto:${contactEmail}`}
          class="text-lg font-medium text-foreground hover:text-primary transition-colors"
        >
          {contactEmail}
        </a>
      </div>

      <!-- Legal links -->
      <div class="mt-16 pt-8 border-t border-border flex gap-6 text-sm text-muted-foreground">
        <a href="/privacy" class="hover:text-foreground transition-colors">
          Privacy Policy
        </a>
        <a href="/tos" class="hover:text-foreground transition-colors">
          Terms of Service
        </a>
      </div>

    </div>
  </main>
</DefaultLayout>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
