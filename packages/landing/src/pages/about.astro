---
import { getEntry, render } from "astro:content";
import AuthorSignOff from "~/components/AuthorSignOff.astro";
import DefaultLayout from "~/layouts/DefaultLayout.astro";
import "~/styles/global.css";

const about = await getEntry("pages", "about");
const { Content } = about ? await render(about) : { Content: null };

const author = { name: "Nick", role: "Founder" };
---

<DefaultLayout>
  <main class="flex-1 pt-header-height">
    <div class="max-w-2xl mx-auto px-6 sm:px-8 py-16 sm:py-24">
      <!-- Header -->
      <div class="mb-12">
        <p
          class="text-xs font-semibold tracking-widest uppercase text-primary mb-4"
        >
          About
        </p>
        <h1
          class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-tight"
        >
          Challenger Fantasy
        </h1>
      </div>

      <!-- Content -->
      <div class="prose prose-neutral dark:prose-invert max-w-none">
        {Content ? <Content /> : <p>Coming soon.</p>}
      </div>

      <!-- Sign-off -->
      <AuthorSignOff name={author.name} role={author.role} />
    </div>
  </main>
</DefaultLayout>
