/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "challenger-fantasy-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-05",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": ["nodejs_compat"],
  /**
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   *
   * These are non-sensitive.
   */
  "vars": {
    "SUPABASE_PROJECT_ID": "asqybhgaovcdrjxsnoej",
    "SUPABASE_URL": "https://asqybhgaovcdrjxsnoej.supabase.co",
    "LOG_LEVEL": "info",
    "PRETTY_LOGS": "false"
  },
  /**
   * https://developers.cloudflare.com/durable-objects/
   */
  "durable_objects": {
    "bindings": [
      {
        "name": "DRAFT_MANAGER",
        "class_name": "DraftManager"
      },
      {
        "name": "DRAFT_SERVER",
        "class_name": "DraftServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DraftManager", "DraftServer"]
    }
  ],
  /**
   * https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
   */
  "routes": [
    {
      "pattern": "api.challengerfantasy.com",
      "custom_domain": true
    }
  ],
  /**
   * CRAWL TRIGGER
   * baseline crawls at 03:00 and 15:00 america/chicago
   * 08:00/20:00 utc ~ 03:00/15:00 cst/cdt
   *
   * example:
   * 8am utc: "0 8 * * *"
   * 5-min tick: "*\/5 * * * *"
   *
   * cleanup at 4am chicago; 9am UTC ("0 9 * * *")
   * crawl at 9am chicago; 2pm UTC ("0 14 * * *")
   */
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
