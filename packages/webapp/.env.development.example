# 
# VITE_ prefixed variables are hard-coded into the build when you run `vite build`
# 
# Running `vite build --mode <mode>` determines the other .env files to include. For
# example, if you run `bunx vite build --mode staging`, your build will load in vars
# defined in `.env` first, then `.env.staging`. Same with `vite dev` for runtime vars.
# 
# Non-VITE_ prefixed variables are runtime based. Building with vite with a mode
# specified will load in the runtime vars, but they're discarded when the build is
# finished. Your runtime has to load in these vars as well.
# 
# Finally: This file is ONLY used for vite. Any and all VITE_ variables need only 
# be defined here. NON-VITE_ PREFIXED VARIABLES OR VARIABLES NOT DEFINED HERE WILL
# NOT APPEAR IN THE CLIENT.
# 

# BUILD VARS

CLOUDFLARE_ENV=development

VITE_APP_NAME=challenger-fantasy-webapp-development
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=

# VITE PREVIEW & DEV RUNTIME VARS (TO OVERWRITE .ENV.LOCAL)

# SUPABASE_SERVICE_KEY=
